[Unit]
Description=Alphin display manager daemon
Requires=alphind.socket
After=alphind.socket
After=systemd-logind.service systemd-tmpfiles-setup.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/lib/alphin/alphind --config /etc/alphin/config.toml
Restart=on-failure
RestartSec=2
StandardOutput=journal+console
StandardError=journal+console
LimitCORE=0

[Install]
WantedBy=graphical.target
