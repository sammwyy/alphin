[Unit]
Description=Alphin display manager daemon
After=systemd-logind.service

[Service]
Type=simple
User=alphin
RuntimeDirectory=alphin
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/alphin/alphind --socket /run/alphin/alphind.sock --sessions /usr/share/wayland-sessions
Restart=on-failure
RestartSec=2
